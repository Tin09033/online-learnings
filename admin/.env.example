# ===========================================
# Admin Panel Environment Variables
# ===========================================
# Copy this file to .env for local development
# For production, set VITE_API_URL to your backend server URL

# API URL - Backend server URL (without /api suffix - it's added automatically)
# Development: Use empty string to rely on Vite proxy, or set to backend URL
# Production: Your backend URL (e.g., https://api.yourdomain.com)
VITE_API_URL=http://localhost:5000

# Examples:
# Local development with proxy: VITE_API_URL=
# Local development direct: VITE_API_URL=http://localhost:5000
# Production: VITE_API_URL=https://your-backend-api.com
