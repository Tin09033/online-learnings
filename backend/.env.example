# ===========================================
# Online Learning Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# -------------------------------------------
# Server Configuration
# -------------------------------------------
# Port for the backend server (default: 5000)
PORT=5000

# Environment: development, production, test
NODE_ENV=development

# -------------------------------------------
# Database Configuration (MySQL)
# -------------------------------------------
# Database host (localhost for local, or Hostinger MySQL host)
DB_HOST=localhost

# Database port (default MySQL port: 3306)
DB_PORT=3306

# Database username
DB_USER=root

# Database password (empty for local XAMPP, set for production)
DB_PASSWORD=

# Database name
DB_NAME=online_learning

# -------------------------------------------
# Authentication Configuration
# -------------------------------------------
# JWT Secret Key - MUST be changed in production!
# Generate a strong 32+ character secret for production
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Token Expiration (default: 7d)
# JWT_EXPIRES_IN=7d

# -------------------------------------------
# CORS Configuration (Production)
# -------------------------------------------
# Frontend URL (for CORS and redirects)
# Example: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Admin Panel URL (for CORS and redirects)
# Example: https://yourdomain.com/admin
ADMIN_URL=http://localhost:3001

# -------------------------------------------
# Optional: Email Configuration (Future)
# -------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# EMAIL_FROM=noreply@yourdomain.com
